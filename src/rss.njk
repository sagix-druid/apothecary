---
permalink: /rss.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/" xmlns:dc="http://purl.org/dc/elements/1.1/">
<channel>
    <title>{{ site.title }}</title>
    <description>{{ site.description }}</description>
    <link>{{ site.url }}/</link>
    <atom:link href="{{ site.url }}/rss.xml" rel="self" type="application/rss+xml"/>
    <language>en</language>
    {%- for post in collections.posts %}
    <item>
        <title>{{ post.data.title }}</title>
        <link>{{ site.url }}{{ post.url }}</link>
        <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
        <dc:creator>{{ site.author }}</dc:creator>
        <pubDate>{{ post.date | rfc822 }}</pubDate>
        <description>{{ post.data.excerpt | trimText }}</description>
        {%- if post.data.feature_image %}
        <media:content url="{{ site.url }}{{ post.data.feature_image }}" medium="image"/>
        {%- endif %}
        <content:encoded><![CDATA[{% if post.data.feature_image %}<img src="{{ site.url }}{{ post.data.feature_image }}" alt="">{% endif %}{{ post.content | forFeed | safe }}]]></content:encoded>
    </item>
    {%- endfor %}
</channel>
</rss>
