---
layout: base.njk
isPost: true
bodyClass: post-template
---
<main id="site-main" class="site-main">
    <article class="article post image-small">
        <header class="article-header gh-canvas">
            <div class="article-tag post-card-tags">
                {% if topics and topics.length %}<span class="post-card-primary-tag"><a href="/tag/{{ topics[0] | topicSlug }}/">{{ topics[0] | topicName }}</a></span>{% endif %}
            </div>
            <h1 class="article-title">{{ title }}</h1>
            {% if excerpt %}
            <p class="article-excerpt">{{ excerpt | trimText }}</p>
            {% endif %}
            <div class="article-byline">
                <section class="article-byline-content">
                    {%- if site.authorImage %}
                    <ul class="author-list instapaper_ignore">
                        <li class="author-list-item">
                            <a href="/author/{{ site.authorSlug }}/" class="author-avatar" aria-label="Read more of {{ site.author }}"><img class="author-profile-image" src="{{ site.authorImage }}" alt="{{ site.author }}"></a>
                        </li>
                    </ul>
                    {%- endif %}
                    <div class="article-byline-meta">
                        <h4 class="author-name"><a href="/author/{{ site.authorSlug }}/">{{ site.author }}</a></h4>
                        <div class="byline-meta-content">
                            <time class="byline-meta-date" datetime="{{ page.date | isoDay }}">{{ page.date | displayDate }}</time>
                            <span class="byline-reading-time"><span class="bull">&bull;</span> {{ content | readingTime }} min read</span>
                        </div>
                    </div>
                </section>
            </div>
            {% if feature_image %}
            <figure class="article-image">
                <img class="gh-feature-image" srcset="{{ feature_image | srcset }}" sizes="(min-width: 1400px) 1400px, 92vw" src="{{ feature_image | sizedImage(1200) }}" alt="{{ feature_image_alt or title }}" fetchpriority="high">
                {% if feature_image_caption %}<figcaption>{{ feature_image_caption | safe }}</figcaption>{% endif %}
            </figure>
            {% endif %}
        </header>

        <section class="gh-content gh-canvas">
            {{ content | safe }}
        </section>
        {#- Every post ends with the subscribe box. A post that already has <!-- signup --> in its text shows it there instead. -#}
        {%- if site.subscribeUrl and "<!-- signup -->" not in content %}
        <section class="gh-content gh-canvas post-signup"><!-- signup --></section>
        {%- endif %}
    </article>
</main>

{% set nextPosts = collections.posts | readNext({ topics: topics, page: page }) %}
{% if nextPosts.length %}
<aside class="read-more-wrap outer">
    <div class="read-more inner">
        {%- for post in nextPosts %}
        {%- set cardClass = "" %}
        {% include "themes/casper/card.njk" %}
        {%- endfor %}
    </div>
</aside>
{% endif %}
