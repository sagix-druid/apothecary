{%- if site.cloudflareAnalyticsToken and eleventy.env.runMode == "build" and not themePreview %}
<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cloudflareAnalyticsToken }}"}'></script>
{%- endif %}
{%- if site.notice %}

<footer class="custom-notice">
  <p>{{ site.notice }}{% if site.noticeLink and site.noticeLink.url %} <a href="{{ site.noticeLink.url }}">{{ site.noticeLink.text }}</a>{% endif %}</p>
  {%- if site.copyright %}
  <p class="custom-notice-copyright">&copy; {{ buildYear }} {{ site.copyright }}. All rights reserved.</p>
  {%- endif %}
</footer>
{%- endif %}
